# EchoMind Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ─── Server ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── JWT Auth ──────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
JWT_EXPIRES_IN=7d

# ─── Firebase ──────────────────────────────────────────────────────────
# Option A: Path to your downloaded service-account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option B: Inline base64-encoded JSON (useful for CI/hosting platforms)
# FIREBASE_SERVICE_ACCOUNT_B64=<base64 encoded JSON>

# Firebase project details
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ─── File uploads ──────────────────────────────────────────────────────
# Max file size in bytes (default 50 MB)
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# ─── Caregiver access code ─────────────────────────────────────────────
CAREGIVER_ACCESS_CODE=caregiver123

# ─── CORS ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
